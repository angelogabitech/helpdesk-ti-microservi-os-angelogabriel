# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.

# Segredo para assinar os tokens de login (mínimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Os três serviços exigem a mesma chave e recusam iniciar com a chave vazia.
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários e ativos de aula e permite carregar chamados de exemplo.
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs (recomendado em produção)
DOCS=1

# Timeouts HTTP em segundos. O gateway precisa de margem para chamadas encadeadas.
USUARIOS_TIMEOUT_SEGUNDOS=3
INVENTARIO_TIMEOUT_SEGUNDOS=3
GATEWAY_TIMEOUT_SEGUNDOS=8

# Rede privada entre gateway e Usuários. O IP fixo fica fora da faixa automática.
GATEWAY_SUBREDE_INTERNA=172.31.46.0/28
GATEWAY_IP_INTERNO=172.31.46.2
GATEWAY_FAIXA_INTERNA=172.31.46.8/29
